<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReportSubmittedDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <!-- Base for TextAppearance.SMARTSTEWARD.* dotted style names (required by aapt). -->
    <style name="TextAppearance.SMARTSTEWARD" parent="TextAppearance.AppCompat" />

    <style name="TextAppearance.SMARTSTEWARD.SectionLabelGreen">
        <item name="android:textColor">@color/activity_title_bar</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.SMARTSTEWARD.MetaLabelGreen">
        <item name="android:textColor">@color/activity_title_bar</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TextAppearance.SMARTSTEWARD.ExampleLinkBold">
        <item name="android:textColor">@color/hint_dark_gray</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="HistoryFilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_history_chip_unselected</item>
        <item name="android:textColor">@color/register_button_green</item>
    </style>
</resources>
