<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SMARTSTEWARD" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SMARTSTEWARD" parent="Base.Theme.SMARTSTEWARD" />

    <style name="Theme.MediaCaptureDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <style name="Widget.SMARTSTEWARD.FilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/register_button_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="checkedIconTint">@color/white</item>
        <item name="rippleColor">@color/activity_card_bg</item>
    </style>

    <style name="Widget.SMARTSTEWARD.NoIncidentReportChip" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">@color/white</item>
        <item name="chipStrokeColor">@color/register_button_green</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/register_button_green</item>
        <item name="chipIconTint">@color/register_button_green</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="chipIconSize">16dp</item>
    </style>
</resources>