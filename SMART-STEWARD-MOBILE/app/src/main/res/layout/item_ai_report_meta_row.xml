<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:gravity="top"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/aiReportMetaIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:tint="@color/activity_title_bar"
        tools:src="@drawable/loc" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/aiReportMetaLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.SMARTSTEWARD.MetaLabelGreen"
            tools:text="Location:" />

        <TextView
            android:id="@+id/aiReportMetaValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/ai_muted"
            android:textSize="12sp"
            tools:text="Cebu City, Philippines" />
    </LinearLayout>
</LinearLayout>
