<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/dashboardMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/dashboardTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="0dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:clipChildren="false"
            android:elevation="3dp">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/autocomplete_container"
                android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dashboardMapScopeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScopeAll"
                    style="@style/Widget.SMARTSTEWARD.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScopeIncidents"
                    style="@style/Widget.SMARTSTEWARD.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incidents" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScopeIllegal"
                    style="@style/Widget.SMARTSTEWARD.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Illegal Activities" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScopeAgencies"
                    style="@style/Widget.SMARTSTEWARD.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agencies" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardFloatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="@dimen/dashboard_zoom_controls_margin_no_sheet"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/dashboardZoomIn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_dashboard_map_fab"
            android:contentDescription="Zoom in"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_map_plus"
            app:tint="@color/activity_title_bar" />

        <ImageButton
            android:id="@+id/dashboardZoomOut"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_map_fab"
            android:contentDescription="Zoom out"
            android:src="@drawable/ic_map_minus"
            android:tint="@color/activity_title_bar" />

        <ImageButton
            android:id="@+id/dashboardMyLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dashboard_map_fab"
            android:contentDescription="My location"
            android:src="@drawable/ic_map_target"
            android:tint="@color/activity_title_bar" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet_surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp"
        android:visibility="gone"
        app:behavior_hideable="true"
        app:behavior_peekHeight="@dimen/dashboard_bottom_sheet_peek"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dashboardNearTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nearby Incidents"
                android:textColor="@color/activity_title_bar"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashboardNearCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 reports"
                android:textColor="@color/activity_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/dashboardTypeFilterRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="0dp"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dashboardNearRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="3"
            tools:listitem="@layout/item_dashboard_near_report" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_dashboard_bottom_nav"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/bottom_nav_icon_size"
                android:layout_height="@dimen/bottom_nav_icon_size"
                android:src="@drawable/home"
                app:tint="@color/register_button_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textColor="@color/register_button_green"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboardNavActivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/bottom_nav_icon_size"
                android:layout_height="@dimen/bottom_nav_icon_size"
                android:src="@drawable/activity"
                app:tint="@color/register_button_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity"
                android:textColor="@color/bottom_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/bottom_nav_fab_size"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/dashboardNavNotification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="@dimen/bottom_nav_icon_size"
                    android:layout_height="@dimen/bottom_nav_icon_size"
                    android:src="@drawable/notification"
                    app:tint="@color/register_button_green" />

                <TextView
                    android:id="@+id/dashboardNavBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="-2dp"
                    android:layout_marginEnd="-4dp"
                    android:background="@drawable/bg_notif_nav_badge_red"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_alerts"
                android:textColor="@color/bottom_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashboardNavProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/bottom_nav_icon_size"
                android:layout_height="@dimen/bottom_nav_icon_size"
                android:src="@drawable/user"
                app:tint="@color/register_button_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textColor="@color/bottom_nav_inactive"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dashboardQuickCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_dashboard_quick_card_light"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#D5DCD6" />

        <TextView
            android:id="@+id/dashboardQuickTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Waste dumping near creek"
            android:textColor="@color/activity_title_bar"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashboardQuickMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Talamban - Reported 2h ago"
            android:textColor="@color/activity_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dashboardQuickPrimaryBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_btn_primary"
                android:gravity="center"
                android:text="@string/dashboard_notify_placeholder"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashboardQuickSecondaryBtn"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_notif_btn_secondary"
                android:gravity="center"
                android:text="Close"
                android:textColor="@color/activity_title_bar"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/dashboardCameraFab"
        android:layout_width="@dimen/bottom_nav_fab_size"
        android:layout_height="@dimen/bottom_nav_fab_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_dashboard_camera_fab"
        android:clickable="true"
        android:elevation="18dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:translationY="@dimen/bottom_nav_fab_lift">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="@string/open_camera"
            android:src="@drawable/camera"
            app:tint="@color/white" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
