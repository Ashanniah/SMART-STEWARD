<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notifCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_notif_card_standard"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/notifAdvisoryStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_review_warning"
            app:tint="@color/notif_gold_text" />

        <TextView
            android:id="@+id/notifAdvisoryLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:textColor="@color/notif_gold_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Area advisory - PNP" />

        <TextView
            android:id="@+id/notifAgencyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_notif_agency_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/activity_rejected_gray"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="PNP" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/notifItemIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_notif_icon_circle_mint"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/notifItemIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/notification"
                android:scaleType="centerInside" />
        </FrameLayout>

        <TextView
            android:id="@+id/notifItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:textColor="#1A1F1C"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/notifItemDot"
            app:layout_constraintStart_toEndOf="@id/notifItemIconBg"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Report Submitted" />

        <TextView
            android:id="@+id/notifItemBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/activity_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/notifItemDot"
            app:layout_constraintStart_toEndOf="@id/notifItemIconBg"
            app:layout_constraintTop_toBottomOf="@id/notifItemTitle"
            tools:text="PNP advisory in Brgy. Talamban" />

        <TextView
            android:id="@+id/notifItemTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/notif_footer_muted"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/notifItemIconBg"
            app:layout_constraintTop_toBottomOf="@id/notifItemBody"
            tools:text="5 min ago" />

        <View
            android:id="@+id/notifItemDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_notif_dot_unread"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/notifItemStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/notifItemDot"
            android:visibility="gone"
            tools:text="Read"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
