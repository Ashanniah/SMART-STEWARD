<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/activity_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0EBE3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/nearRowThumbContainer"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/nearRowPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/near_report_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_near_report_thumb_placeholder"
                    tools:ignore="ImageContrastCheck" />

                <ImageView
                    android:id="@+id/nearRowVideoPlay"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/play_video"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/white"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nearRowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/activity_title_bar"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="Illegal Dumping" />

                    <TextView
                        android:id="@+id/nearRowStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:background="@color/activity_pending_orange"
                        tools:text="Pending" />
                </LinearLayout>

                <include
                    android:id="@+id/nearRowLocation"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/nearRowDate"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/nearRowTime"
                    layout="@layout/include_my_activity_detail_row" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
