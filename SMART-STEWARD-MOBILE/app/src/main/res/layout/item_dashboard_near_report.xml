<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/activity_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E0EBE3"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/nearRowTypeIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dashboard_search"
            android:gravity="center"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="📋" />

        <TextView
            android:id="@+id/nearRowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/activity_title_bar"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/nearRowStatus"
            app:layout_constraintStart_toEndOf="@id/nearRowTypeIcon"
            app:layout_constraintTop_toTopOf="@id/nearRowTypeIcon"
            tools:text="Illegal Dumping" />

        <TextView
            android:id="@+id/nearRowMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/activity_muted"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/nearRowTitle"
            app:layout_constraintStart_toStartOf="@id/nearRowTitle"
            app:layout_constraintTop_toBottomOf="@id/nearRowTitle"
            tools:text="Lahug · 2h ago" />

        <TextView
            android:id="@+id/nearRowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/nearRowTypeIcon"
            tools:background="@color/activity_pending_orange"
            tools:text="Pending" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
