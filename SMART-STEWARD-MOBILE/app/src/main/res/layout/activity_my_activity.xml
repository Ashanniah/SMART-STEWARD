<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/myActivityRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_page_bg"
    android:clipChildren="true"
    android:clipToPadding="true">

    <LinearLayout
        android:id="@+id/myActivityTopBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/activity_header_green"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/myActivityBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_back"
                android:padding="8dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/my_activity_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="40dp"
                android:layout_height="40dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_card"
                android:orientation="vertical"
                android:padding="12dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:background="@color/activity_accent_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/my_activity_total"
                    android:textColor="@color/activity_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/myActivityStatTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="14" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_card"
                android:orientation="vertical"
                android:padding="12dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:background="@color/activity_pending_orange" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/my_activity_pending"
                    android:textColor="@color/activity_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/myActivityStatPending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_stat_card"
                android:orientation="vertical"
                android:padding="12dp">

                <View
                    android:layout_width="32dp"
                    android:layout_height="3dp"
                    android:background="@color/activity_resolved_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/my_activity_resolved"
                    android:textColor="@color/activity_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/myActivityStatResolved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="10" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/myActivityFilterDimensionSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_filter"
                android:backgroundTint="@null"
                android:dropDownVerticalOffset="4dp"
                android:elevation="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:popupBackground="@android:color/white"
                android:stateListAnimator="@null" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/myActivityFilterValueSpinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_filter"
                android:backgroundTint="@null"
                android:dropDownVerticalOffset="4dp"
                android:elevation="0dp"
                android:minHeight="48dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp"
                android:popupBackground="@android:color/white"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/my_activity_recent_reports"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/myActivityRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="88dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myActivityTopBlock"
        tools:listitem="@layout/item_my_activity_report" />

    <TextView
        android:id="@+id/myActivityEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/my_activity_no_reports"
        android:textColor="@color/activity_muted"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/myActivityRecycler"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/myActivityTopBlock" />

    <include
        layout="@layout/include_main_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bottom_nav_horizontal_inset"
        android:layout_marginEnd="@dimen/bottom_nav_horizontal_inset"
        android:layout_marginBottom="@dimen/bottom_nav_bottom_inset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
