<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/activity_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#14000000"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/reportThumbContainer"
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/reportThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_report_thumbnail"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/reportTypeEmojiFallback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_activity_type_tile"
                    android:gravity="center"
                    android:textSize="22sp"
                    tools:text="🔥" />

                <ImageView
                    android:id="@+id/reportVideoPlay"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/play_video"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_play"
                    android:tint="@color/white"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/reportRowStatus"
                    layout="@layout/include_my_activity_detail_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp" />

                <include
                    android:id="@+id/reportRowType"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/reportRowDate"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/reportRowTime"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/reportRowLocation"
                    layout="@layout/include_my_activity_detail_row" />

                <include
                    android:id="@+id/reportRowAgency"
                    layout="@layout/include_my_activity_detail_row" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reportBtnSecondary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_outline_btn"
                android:gravity="center"
                android:text="@string/my_activity_view_map"
                android:textColor="@color/activity_header_green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reportBtnPrimary"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_activity_primary_btn"
                android:gravity="center"
                android:text="@string/my_activity_track"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
