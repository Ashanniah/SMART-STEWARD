<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/activity_page_bg">

    <LinearLayout
        android:id="@+id/editProfileTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/activity_header_green"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/editProfileBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/cd_back"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/edit_profile_title"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/editProfileSaveButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editProfileTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edit_profile_summary_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_profile_avatar_circle">

                    <ImageView
                        android:id="@+id/editProfileAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/profile_avatar_content_desc"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/default_profile" />

                    <TextView
                        android:id="@+id/editProfileHeaderInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/profile_avatar_text"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="RK" />
                </FrameLayout>

                <TextView
                    android:id="@+id/editProfileHeaderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Russel Kupal Cabral" />

                <TextView
                    android:id="@+id/editProfileHeaderEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/activity_muted"
                    android:textSize="13sp"
                    tools:text="russelcabral@gmail.com" />

                <TextView
                    android:id="@+id/editProfileJoinedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_profile_badge_new"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Joined since 2026" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/user"
                    app:tint="@color/activity_title_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/edit_profile_personal_info"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_profile_summary_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/first_name"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfileFirstNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/edit_profile_ic_user"
                    android:drawablePadding="10dp"
                    android:hint="@string/edit_profile_hint_first_name"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/middle_name"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfileMiddleNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/edit_profile_ic_user"
                    android:drawablePadding="10dp"
                    android:hint="@string/edit_profile_hint_middle_name"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/last_name"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfileLastNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/edit_profile_ic_user"
                    android:drawablePadding="10dp"
                    android:hint="@string/edit_profile_hint_last_name"
                    android:importantForAutofill="yes"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/user"
                    app:tint="@color/activity_title_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/edit_profile_contact_info"
                    android:textColor="@color/activity_title_bar"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_edit_profile_summary_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email_address"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfileEmailInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/edit_profile_ic_email"
                    android:drawablePadding="10dp"
                    android:enabled="false"
                    android:focusable="false"
                    android:hint="@string/edit_profile_hint_email"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/activity_muted"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/edit_profile_home_address"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfileHomeAddressInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/home"
                    android:drawablePadding="12dp"
                    android:hint="@string/edit_profile_hint_home_address"
                    android:importantForAutofill="yes"
                    android:inputType="textPostalAddress|textCapSentences"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/edit_profile_phone_number"
                    android:textColor="@color/activity_muted"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/editProfilePhoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_edit_profile_input"
                    android:drawableStart="@drawable/edit_profile_ic_phone"
                    android:drawablePadding="10dp"
                    android:hint="@string/edit_profile_hint_phone"
                    android:importantForAutofill="yes"
                    android:inputType="phone"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/activity_muted"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/editProfileSaveButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_edit_profile_save_btn"
        android:gravity="center"
        android:text="@string/action_save_profile"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
